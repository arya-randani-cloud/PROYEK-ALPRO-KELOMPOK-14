#include <iostream>
#include <vector>
#include <string>
#include <iomanip>

using namespace std;

struct Produk {
    int id;
    string nama;
    string kategori;
    double harga;
    int stok;
};

// Fungsi menampilkan katalog
void tampilkanKatalog(const vector<Produk>& katalog) {
    if (katalog.empty()) {
        cout << "\n[!] Katalog toko masih kosong!\n";
        return;
    }

    cout << "\n======================================================================\n";
    cout << "                         DAFTAR BARANG TOKO                           \n";
    cout << "======================================================================\n";
    cout << left << setw(5) << "ID" 
         << setw(22) << "Nama Produk" 
         << setw(15) << "Kategori" 
         << setw(15) << "Harga" 
         << setw(10) << "Stok" << endl;
    cout << "----------------------------------------------------------------------\n";

    for (const auto& p : katalog) {
        cout << left << setw(5) << p.id 
             << setw(22) << p.nama 
             << setw(15) << p.kategori 
             << "Rp " << setw(12) << fixed << setprecision(0) << p.harga 
             << setw(10) << p.stok << endl;
    }
    cout << "======================================================================\n";
}

// Fungsi Ringkasan Keuangan / Aset Toko
void hitungTotalAset(const vector<Produk>& katalog) {
    double totalAset = 0;
    int totalBarang = 0;

    for (const auto& p : katalog) {
        totalAset += (p.harga * p.stok);
        totalBarang += p.stok;
    }

    cout << "\n=========================================\n";
    cout << "         LAPORAN RINGKASAN TOKO          \n";
    cout << "=========================================\n";
    cout << " Total Jenis Produk : " << katalog.size() << " jenis\n";
    cout << " Total Stok Barang  : " << totalBarang << " pcs\n";
    cout << " Total Nilai Aset   : Rp " << fixed << setprecision(0) << totalAset << endl;
    cout << "=========================================\n";
}

int main() {
    vector<Produk> katalog;
    int pilihan;
    int counterId = 101; // ID dimulai dari 101 agar terlihat rapi

    // Data Awal Toko
    katalog.push_back({counterId++, "Kopi Kenangan", "Minuman", 18000, 40});
    katalog.push_back({counterId++, "Roti Cokelat", "Makanan", 12000, 25});
    katalog.push_back({counterId++, "Susu Kotak UHT", "Minuman", 6500, 100});

    do {
        cout << "\n========== DASHBOARD ADMIN TOKO ==========\n";
        cout << "1. Lihat Semua Stok Barang\n";
        cout << "2. Tambah Produk Baru\n";
        cout << "3. Update Stok Barang (Restock)\n";
        cout << "4. Hapus Produk dari Toko\n";
        cout << "5. Lihat Laporan Aset Toko\n";
        cout << "6. Keluar Aplikasi\n";
        cout << "------------------------------------------\n";
        cout << "Pilih Menu (1-6): ";
        cin >> pilihan;

        if(cin.fail()) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "[!] Input salah! Masukkan angka menu.\n";
            continue;
        }

        switch (pilihan) {
            case 1:
                tampilkanKatalog(katalog);
                break;

            case 2: {
                Produk pBaru;
                pBaru.id = counterId++;
                cin.ignore();
                cout << "\n--- Tambah Produk Baru ---\n";
                cout << "Nama Produk : "; getline(cin, pBaru.nama);
                cout << "Kategori    : "; getline(cin, pBaru.kategori);
                cout << "Harga Jual  : Rp "; cin >> pBaru.harga;
                cout << "Stok Awal   : "; cin >> pBaru.stok;

                katalog.push_back(pBaru);
                cout << "\n[Sukses] Produk " << pBaru.nama << " berhasil didaftarkan!\n";
                break;
            }

            case 3: {
                int idCari, stokBaru;
                bool ditemukan = false;
                cout << "\nMasukkan ID Produk yang akan di-update: ";
                cin >> idCari;

                for (auto& p : katalog) {
                    if (p.id == idCari) {
                        cout << "Produk Ditemukan: " << p.nama << " (Stok Saat Ini: " << p.stok << ")\n";
                        cout << "Masukkan Jumlah Stok Tambahan: ";
                        cin >> stokBaru;
                        p.stok += stokBaru; // Menambahkan stok lama dengan yang baru
                        cout << "\n[Sukses] Stok " << p.nama << " berhasil diperbarui menjadi " << p.stok << " pcs.\n";
                        ditemukan = true;
                        break;
                    }
                }
                if (!ditemukan) cout << "[!] Produk dengan ID " << idCari << " tidak ditemukan.\n";
                break;
            }

            case 4: {
                int idHapus;
                bool ditemukan = false;
                cout << "\nMasukkan ID Produk yang ingin dihapus: ";
                cin >> idHapus;

                for (auto it = katalog.begin(); it != katalog.end(); ++it) {
                    if (it->id == idHapus) {
                        cout << "[Peringatan] Menghapus " << it->nama << " dari sistem...\n";
                        katalog.erase(it); // Menghapus elemen dari vector
                        cout << "[Sukses] Produk telah dihapus.\n";
                        ditemukan = true;
                        break;
                    }
                }
                if (!ditemukan) cout << "[!] Produk dengan ID " << idHapus << " tidak ditemukan.\n";
                break;
            }

            case 5:
                hitungTotalAset(katalog);
                break;

            case 6:
                cout << "\nKeluar dari Sistem Admin. Sampai jumpa!\n";
                break;

            default:
                cout << "[!] Pilihan menu tidak tersedia.\n";
        }
    } while (pilihan != 6);

    return 0;
}
