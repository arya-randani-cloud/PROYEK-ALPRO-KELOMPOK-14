#include <iostream>
#include <vector>
#include <string>
#include <iomanip>

using namespace std;

// Struktur data untuk menyimpan informasi produk
struct Produk {
    int id;
    string nama;
    string kategori;
    double harga;
    int stok;
};

// Fungsi untuk menampilkan semua produk dalam bentuk tabel
void tampilkanKatalog(const vector<Produk>& katalog) {
    if (katalog.empty()) {
        cout << "\n=========================================\n";
        cout << "Katalog masih kosong!\n";
        cout << "=========================================\n";
        return;
    }

    cout << "\n======================================================================\n";
    cout << "                           KATALOG PRODUK                             \n";
    cout << "======================================================================\n";
    cout << left << setw(5) << "ID" 
         << setw(20) << "Nama Produk" 
         << setw(15) << "Kategori" 
         << setw(15) << "Harga" 
         << setw(10) << "Stok" << endl;
    cout << "----------------------------------------------------------------------\n";

    for (const auto& p : katalog) {
        cout << left << setw(5) << p.id 
             << setw(20) << p.nama 
             << setw(15) << p.kategori 
             << "Rp " << setw(12) << fixed << setprecision(0) << p.harga 
             << setw(10) << p.stok << endl;
    }
    cout << "======================================================================\n";
}

// Fungsi untuk mencari produk berdasarkan nama
void cariProduk(const vector<Produk>& katalog, string namaCari) {
    bool ditemukan = false;
    cout << "\nHasil pencarian untuk '" << namaCari << "':\n";
    
    for (const auto& p : katalog) {
        // Mengubah ke huruf kecil atau pencarian substring sederhana
        if (p.nama.find(namaCari) != string::npos) {
            if (!ditemukan) {
                cout << left << setw(5) << "ID" << setw(20) << "Nama" << setw(15) << "Harga" << endl;
                cout << "--------------------------------------------------\n";
            }
            cout << left << setw(5) << p.id << setw(20) << p.nama << "Rp " << p.harga << endl;
            ditemukan = true;
        }
    }
    
    if (!ditemukan) {
        cout << "Produk tidak ditemukan.\n";
    }
}

int main() {
    vector<Produk> katalog;
    int pilihan;
    int counterId = 1; // Untuk generate ID otomatis

    // Data awal (Opsional, biar katalog tidak kosong saat pertama dijalankan)
    katalog.push_back({counterId++, "Laptop Asus", "Elektronik", 8500000, 10});
    katalog.push_back({counterId++, "Mouse Logitech", "Elektronik", 150000, 25});
    katalog.push_back({counterId++, "Kemeja Polos", "Pakaian", 125000, 50});

    do {
        cout << "\n=== MENU MANAJEMEN KATALOG ===\n";
        cout << "1. Tampilkan Katalog\n";
        cout << "2. Tambah Produk\n";
        cout << "3. Cari Produk\n";
        cout << "4. Keluar\n";
        cout << "Pilih menu (1-4): ";
        cin >> pilihan;

        // Validasi input menu
        if(cin.fail()) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Input tidak valid! Masukkan angka.\n";
            continue;
        }

        switch (pilihan) {
            case 1:
                tampilkanKatalog(katalog);
                break;
            case 2: {
                Produk pBaru;
                pBaru.id = counterId++;
                
                cin.ignore(); // Membersihkan buffer input
                cout << "Masukkan Nama Produk: ";
                getline(cin, pBaru.nama);
                cout << "Masukkan Kategori   : ";
                getline(cin, pBaru.kategori);
                cout << "Masukkan Harga      : Rp ";
                cin >> pBaru.harga;
                cout << "Masukkan Stok       : ";
                cin >> pBaru.stok;

                katalog.push_back(pBaru);
                cout << "\n> Produk berhasil ditambahkan ke katalog!\n";
                break;
            }
            case 3: {
                string namaCari;
                cin.ignore();
                cout << "Masukkan nama produk yang dicari: ";
                getline(cin, namaCari);
                cariProduk(katalog, namaCari);
                break;
            }
            case 4:
                cout << "\nTerima kasih telah menggunakan program katalog!\n";
                break;
            default:
                cout << "Pilihan tidak tersedia. Silakan coba lagi.\n";
        }
    } while (pilihan != 4);

    return 0;
}
